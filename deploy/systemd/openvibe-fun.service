[Unit]
Description=OpenVibe.Fun — something to do, alone, together, or live.
# Network (sign-in, JWKS, account events) should be up first, but Fun degrades honestly without it: the public pages
# and the guide serve, and sign-in and the guarded routes wait for the signing key (see /api/ready). Live, Chat and
# Today are public upstreams and are not required to start.
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=openvibe-network.service postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.fun
EnvironmentFile=/etc/openvibe/fun.env
Environment=NODE_ENV=production
Environment=PORT=5140
Environment=HOST=127.0.0.1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.fun/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
# In-flight requests get the 10 s drain.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# OpenVibe.Fun's own database is PostgreSQL on the host's data role; the code tree stays read-only.

[Install]
WantedBy=multi-user.target
